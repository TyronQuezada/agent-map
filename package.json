{
  "name": "agent-map",
  "productName": "Agent Map",
  "version": "0.8.0",
  "private": true,
  "description": "Panel para ver y retomar sesiones de Claude Code",
  "author": "Tyron",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "test": "node --test --test-force-exit",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.tyron.agentmap",
    "productName": "Agent Map",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "statusline-tap.js",
      "lib/**",
      "public/**",
      "electron/**",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Map",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
